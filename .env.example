# Copy to .env and customize. No credentials are hardcoded.
DATABASE_URL=sqlite:///./data/showroom.db
HOST=127.0.0.1
PORT=8000
# Optional: set a strong, private token for the first-admin setup screen.
# When omitted, a random setup token is printed in the server terminal.
BOOTSTRAP_TOKEN=
# Turn ON when behind HTTPS, required for production environments.
COOKIE_SECURE=false
# Comma-separated allowed hosts. Use a real domain behind a reverse proxy.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Registration defaults OFF. Admins can create team accounts instead.
ALLOW_PUBLIC_REGISTRATION=false
